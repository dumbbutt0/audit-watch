# ── Secrets / environment ─────────────────────────────────────────────
# (.mcp.json has inline API keys; commit .mcp.json.example instead)
.env
.env.*
!.env.example
.mcp.json
!.mcp.json.example

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.pytest_cache/

# ── Generated per-run artifacts ───────────────────────────────────────
# (/output is the root symlink to the active audit's output — ignore the symlink itself + the dir)
/output
kb/
data/triage/*.jsonl

# ── Third-party cloned target source (not ours to redistribute) ───────
**/_sources/
**/_src/
audit_downloads/
contracts/
documentation/research/assisted_mode/p212_pseudo_live_hunt/targets/

# ── Build artifacts ───────────────────────────────────────────────────
**/build/
**/target/
**/node_modules/
**/.anchor/

# ── Large archives ────────────────────────────────────────────────────
*.zip
*.tar.gz

# ── Per-audit working data (small eval fixtures re-added with -f) ──────
audits/*/contracts/
audits/*/pocs/
audits/*/data/
audits/*/status/
audits/*/notes/
audits/*/reports/
audits/*/findings/
audits/*/output/
audits/*/session.json
audits/*/_contaminated_*_archive_*/
pocs/
reports/*/harness/
tmp_p139/
tmp/
screenshots/
.claude/scheduled_tasks.lock
documentation/real_world_results.json.bak.*
