{
  "schema_version": 1,
  "_note": "Stage-1 policy (gates 1-3 only): RAW_CANDIDATE -> CONTEXT_MAPPED. PoC/report/promotion are out of scope here and hard-blocked.",
  "stage1_gate_order": ["source_resolve", "reachability", "context_map"],
  "stage2_gate_order": ["defense_map", "invariant"],
  "stop_state": "CONTEXT_MAPPED",
  "next_required_gate": "defense_map_gate",
  "next_required_gate_after_invariant": "sequence_gate",
  "poc_allowed": false,
  "report_allowed": false,
  "detector_requirements": {
    "multicall_invariant": {
      "context_map_terms": [
        "isMulticall",
        "functionDelegateCall(address(this)",
        "delegatecall",
        "borrowAToken",
        "debtToken",
        "balanceOf(address(this))",
        "totalSupply",
        "validateBorrowATokenIncreaseLteDebtTokenDecrease"
      ],
      "facade_name_hint": "multicall",
      "final_invariant_functions": ["validateBorrowATokenIncreaseLteDebtTokenDecrease"],
      "per_call_checks": ["validateBorrowATokenCap"]
    }
  },
  "privileged_modifier_terms": ["onlyOwner", "onlyRole", "onlyGovernance", "onlyAdmin", "requiresAuth", "auth"],
  "accounting_terms": ["borrowAToken", "debtToken", "balanceOf", "totalSupply", "credit", "debt", "collateral", "cap"],
  "validation_terms": ["validate", "require", "revert", "check"]
}
