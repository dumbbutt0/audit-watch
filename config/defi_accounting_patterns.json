{
  "schema_version": 1,
  "description": "DeFi debt/credit CONSERVATION taxonomy for accounting-heavy protocols (Zaros-class perps + market-making). Models whether debt, credit, capacity, assets, rewards, or liquidity can become INCONSISTENT ACROSS FUNCTIONS while each function looks locally reasonable. Drives defi_accounting_audit.py via defi_accounting_taxonomy.classify(). Addresses the Zaros Part 2 eval miss cluster (14/16 Highs): settleVaultsDebt, withdrawUsdTokenFromMarket, getRealizedDebtUsd, recalculateVaultsCreditCapacity, rebalanceVaultsAssets, AutoDeleverageFactor, WETH reward distribution, market-vault disconnection, usdcAvailableForEngine lockup.",
  "_fp_note": "NOT a flag-all-arithmetic / flag-all-'debt'-keyword sweep. A function is accounting-sensitive ONLY with (1) an accounting-DOMAIN signal (a debt/credit/capacity/asset/reward/liquidity state var or call) AND (2) a STATE-TRANSITION or non-trivial ARITHMETIC signal (a write to that ledger var, a signed/unsigned cast, an oracle-scaled mul/div, or a +=/-=/sub/add on accounting state). HIGH-RISK requires BOTH signals. Pure getters that only return stored config, plain balanceOf reads, generic ERC20 transfers not tied to ledger state, admin config setters, and comments are NOT tagged. Comments are stripped before matching.",

  "accounting_domain_signals": [
    "debt", "credit", "creditcapacity", "creditdelegation", "capacity", "realizeddebt", "unrealizeddebt",
    "marketsrealizeddebt", "marketsunrealizeddebt", "unsettledrealizeddebt", "depositedusdc",
    "usdcavailableforengine", "totalassets", "totaldebt", "vaultassets", "marketassets", "collateral",
    "reward", "wethreward", "valuepershare", "distribution", "pnl", "profit", "funding", "fundingfee",
    "deleverage", "autodeleverage", "adl", "liquidity", "shares", "indextoken", "lockedcredit",
    "netusdtokenissuance", "usdtoken", "issuance", "solvency", "depositcap"
  ],
  "_state_transition_note": "A transition = a WRITE to accounting state: compound ops (+=/-=/.add/.sub), a ledger mint/burn/distribute, or a plain ASSIGNMENT to a global-total / weight / shares ledger var (the global-vs-user conservation signal). Plain assignment to a non-ledger field (admin config) is NOT here.",
  "state_transition_signals": [
    "+=", "-=", "\\.add\\(", "\\.sub\\(", "\\.mul\\(", "\\.div\\(",
    "marketsrealizeddebtusd\\s*[-+]?=", "marketsunrealizeddebtusd\\s*[-+]?=", "depositedusdc\\s*[-+]?=",
    "usdcavailableforengine\\s*[-+]?=", "updatenetusdtokenissuance", "settlecreditdeposit",
    "distributevalue", "updatetotaldelegatedcredit", "\\.mint\\(", "\\.burn\\(",
    "totalcreditdelegationweight\\s*=", "totalshares\\s*=", "\\.weight\\s*=", "valuepershare\\s*=",
    "setactorshares", "settotalshares",
    "recalculate", "settle", "rebalance", "accumulate"
  ],
  "arithmetic_signals": [
    "\\.add\\(", "\\.sub\\(", "\\.mul\\(", "\\.div\\(", "muldiv", "\\+=", "\\-=", "\\*", "/ ",
    "intoint256", "intouint256", "intouint128", "intosd59x18", "intoud60x18"
  ],
  "_signed_unsigned_note": "CASTS/conversions only — NOT bare type declarations. A function whose signature merely contains 'uint128' is not a conversion risk; the risk is an explicit cast (toInt128/intoUint256/abs/unary) that can truncate or flip the sign of an accounting value.",
  "signed_unsigned_signals": [
    "toint128\\(", "toint256\\(", "touint128\\(", "touint256\\(",
    "intoint256\\(", "intoint128\\(", "intouint256\\(", "intouint128\\(",
    "\\babs\\(", "\\bunary\\(", "lt\\(sd59x18_zero", "lte\\(sd59x18_zero", "gt\\(sd59x18_zero",
    "int256\\(", "int128\\(", "uint256\\(", "uint128\\("
  ],
  "oracle_scale_signals": [
    "getprice", "getadjustedprice", "priceadapter", "indexprice", "convertsd59x18totokenamount",
    "convertud60x18totokenamount", "converttokenamounttoud60x18", "converttokenamounttosd59x18",
    "decimaloffset", "system_decimals", "decimals", "10 **", "10**"
  ],
  "getter_suppression_hints": [
    "return self.", "return _get", "return s.", "= load(", "loadexisting", "return stored"
  ],
  "admin_hints": [
    "onlyowner", "onlyregisteredengine", "onlyregisteredsystemkeepers", "onlymarketmakingengine",
    "ownableupgradeable", "_authorizeupgrade", "configure", "setconfig"
  ],

  "high_risk_categories": [
    "vault_debt", "market_debt", "realized_debt", "unrealized_debt", "credit_capacity",
    "credit_delegation", "settlement_order", "rebalance_accounting", "reward_distribution",
