{
  "hermes_enabled": true,
  "hermes_root": "../hermes",
  "routing_policy_path": "../hermes/routing_policy.yaml",
  "role_path": "../hermes/role.md",
  "project_map_path": "../hermes/project_map.md",
  "memory_path": "../hermes/memory",
  "verdicts_path": "../hermes/verdicts",
  "integration": {
    "emit_events": true,
    "read_routing": true,
    "write_recap": true,
    "write_memory": true
  },
  "emit_timeout_seconds": 0,
  "routing_read_timeout_seconds": 2,
  "recap_on_session_end": true,
  "routing_consult_points": [
    "pre_deep_analysis",
    "pre_triage",
    "pre_poc_escalation",
    "pre_submission_gate",
    "post_exploit_proved",
    "post_session"
  ],
  "memory_write_points": [
    "finding_confirmed",
    "finding_rejected",
    "poc_proved",
    "poc_failed",
    "triage_decision",
    "gate_decision",
    "session_end"
  ]
}