{
  "version": "mechanism-advancement-gate-v1",
  "description": "Phase-45 RESEARCH-ONLY generalized mechanism advancement gate. Read ONLY by scripts/mechanism_advancement_gate.py (un-wired). Runs AFTER mechanism discrimination on every candidate whose pre-gate state is ADVANCE, and TIGHTENS — it can only output ADVANCE/REVIEW_ONLY/ABSTAIN, never promote. Applies P34-calibre corroboration to EVERY mechanism family (missing_bound/missing_cap/omitted_term/missing_scale/computed_unapplied as well as the sibling-call-delta families). Sibling-call-delta still routes through the UNCHANGED comparand_parity_gate (P34); this gate adds stricter checks, never bypasses P34. Generic only — NO subject identifiers. is_gate:false research_only:true routes_in_production:false routed_manifest_ids:[].",
  "is_gate": false,
  "research_only": true,
  "routes_in_production": false,
  "routed_manifest_ids": [],

  "standard_token_primitives": ["transfer", "transferfrom", "approve", "allowance", "balanceof", "totalsupply", "decimals", "name", "symbol", "nonces", "domain_separator", "permit", "supportsinterface"],
  "interface_contract_re": "^I[A-Z]",
  "interface_file_signals": ["/interfaces/", "/interface/"],
  "getter_name_re": "^(get|is|view|peek|latest|current|preview|quote)",
  "view_mutabilities": ["view", "pure"],

  "value_authority_domain_terms": ["debt", "collateral", "share", "fee", "penalty", "reward", "balance", "price", "oracle", "amount", "value", "recipient", "owner", "liquidat", "settle", "redeem", "borrow", "repay", "mint", "burn", "role", "auth", "admin", "permission"],
  "bound_terms": ["cap", "bound", "limit", "ceiling", "floor", "maxsupply", "borrowcap", "supplycap", "closefactor", "healthfactor", "maxrepay", "maxliquidation"],
  "scale_tokens": ["scale", "decimals", "precision"],
  "scale_ops": ["wmul", "muldiv", "mulwad", "wdiv", "rmul", "mulwadup"],
  "transfer_state_signals": ["transfer", "safetransfer", "mint", "burn", "+=", "-=", "settle", "disburse", "repay", "borrow", "= "],

  "sibling_call_delta_mechanisms": ["missing_call", "recipient_missing", "wrong_basis"],
  "intra_function_mechanisms": ["omitted_term", "computed_unapplied"],

  "required_checks": {
    "missing_bound": ["operation_kinship", "shared_value_domain", "downstream_effect", "non_design_absence", "source_corroboration"],
    "omitted_term": ["shared_value_domain", "downstream_effect", "non_design_absence", "source_corroboration"],
    "missing_scale": ["operation_kinship", "shared_value_domain", "downstream_effect", "non_design_absence", "source_corroboration"],
    "computed_unapplied": ["shared_value_domain", "downstream_effect", "non_design_absence", "source_corroboration"],
    "missing_call": ["non_design_absence", "source_corroboration"],
    "recipient_missing": ["non_design_absence", "source_corroboration"],
    "wrong_basis": ["non_design_absence", "source_corroboration"]
  },
  "_alias": {"missing_cap": "missing_bound"}
}
