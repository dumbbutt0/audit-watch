{
  "version": "e1d-v1",
  "description": "Phase-15 vocabulary-expanded semantic surface sampler (e1d-v1; was e1b-v1). RESEARCH-ONLY. Category NAME-regex (primary signal) used by deep_pass_prepare.py --surface-sample to build a candidate queue that feeds the agentic deep-pass BEYOND detector-routed candidates. Categories are generic high-bug-density surfaces (NOT answer-key-derived). tag_hints are kept EMPTY by default: the coarse manifest tags (accounting/token/permissions) don't distinguish the fine categories and pollute selected_by provenance (a single accounting-tagged fn would map into 4 categories). Provenance must stay meaningful for the 'which source produces bugs?' analysis. Coverage queue = full union (no caps); reasoning queue = per-category cap. is_gate:false, research_only:true, routes_in_production:false.",
  "is_gate": false,
  "research_only": true,
  "routes_in_production": false,
  "routed_manifest_ids": [],
  "default_min_score": 2,
  "categories": {
    "validator": {
      "name_regex": "validate|verify|_?check|authoriz|_?isapprov|ensure|require|block|freeze|sanction|whitelist|blacklist|allow|permit",
      "tag_hints": [],
      "min_score": 2,
      "cap": 12
    },
    "accounting": {
      "name_regex": "tvl|balance|debt|ceiling|multiplier|account|totalsupply|sharesto|underlying|exchangerate|convert|reserve|getamount|value",
      "tag_hints": [],
      "min_score": 2,
      "cap": 12
    },
    "reward": {
      "name_regex": "reward|claim|earned|distribute|notify|harvest|incentive|fee",
      "tag_hints": [],
      "min_score": 2,
      "cap": 10
    },
    "liquidation": {
      "name_regex": "liquidat|seize|health|collateral|undercollateral|solvency|margin|insolven",
      "tag_hints": [],
      "min_score": 2,
      "cap": 10
    },
    "mint_redeem": {
      "name_regex": "mint|redeem|deposit|withdraw|_?burn|issue|stake|unstake|calculatetvl|buy|sell|swap|exchange|shares?",
      "tag_hints": [],
      "min_score": 2,
      "cap": 12
    },
    "borrow_repay": {
      "name_regex": "borrow|repay|loan|credit|leverage|flashloan",
      "tag_hints": [],
      "min_score": 2,
      "cap": 10
    },
    "position_xfer": {
      "name_regex": "transfer|_?move|removetoken|removefrom|merge|delegate|checkpoint|split|_burn",
      "tag_hints": [],
      "min_score": 2,
      "cap": 10
    },
    "registry_mut": {
      "name_regex": "register|deregister|addtoken|removetoken|addcollateral|setoperator|setrate|enable|disable|updateconfig|setconfig",
      "tag_hints": [],
      "min_score": 3,
      "cap": 8
    },
    "oracle": {
      "name_regex": "oracle|answer|feed|price|twap|reserve|quote|valuation|spot|peek",
      "tag_hints": [],
      "min_score": 2,
      "cap": 10
    },
    "aggregator": {
      "name_regex": "aggregat|adapter|router|strateg|vault|wrapper",
      "tag_hints": [],
      "min_score": 3,
      "cap": 8
    }
  }
}