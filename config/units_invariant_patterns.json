{
  "schema_version": 1,
  "description": "Taxonomy of decimals/units/scaling invariant surfaces. Drives units_invariant_audit.py via units_invariant_taxonomy.classify(). Surfaces math where token decimals, oracle decimals, reserve units, BDV units, LP/share units, price precision, or amount scaling can be silently mixed \u2014 the class behind eval miss #184 (LibWell.getBeanTokenPriceFromTwaReserves assumes 18 decimals: reserve0.mul(1e18).div(reserve1)). This is a SEMANTIC math lens, NOT a flag-all-arithmetic sweep.",
  "_fp_note": "TWO-SIGNAL RULE is the FP backbone: an item is units_sensitive only when a UNIT-CONTEXT term (unit_context_terms below) co-occurs with an ARITHMETIC/DECIMALS SIGNAL (a category call/constant/arithmetic pattern) \u2014 UNLESS the category is itself unambiguous (decimals()/latestRoundData/convertToShares). Bare 1e18, a lone mulDiv, basis-points (100/10000) without amount context, pure Math/PRBMath helpers, and loop-counter division are NOT tagged. Comments and event decls are stripped before matching.",
  "unit_context_terms": [
    "price",
    "reserve",
    "bdv",
    "oracle",
    "shares",
    "assets",
    "precision",
    "decimal",
    "twa",
    "wsteth",
    "steth",
    "underlying",
    "deltab",
    "amountout",
    "amountin",
    "pump",
    "virtualprice",
    "pricepershare",
    "exchangerate",
    "latestround",
    "lptoken"
  ],
  "high_risk_categories": [
    "assumed_18_decimals",
    "chainlink_decimals",
    "oracle_price_decimals",
    "reserve_units",
    "twa_reserves",
    "shares_assets",
    "mixed_decimal_tokens",
    "division_before_multiplication",
    "downcast_after_scaling",
    "price_per_share",
    "virtual_price"
  ],
  "categories": {
    "token_decimals": {
      "name_patterns": [
        "decimals",
        "todecimals",
        "fromdecimals",
        "scaledecimals",
        "normalizedecimals"
      ],
      "call_patterns": [
        ".decimals()",
        "erc20(",
        "ierc20metadata",
        "decimals("
      ],
      "constant_patterns": [],
      "arithmetic_patterns": [
        "10\\s*\\*\\*\\s*\\w*decimals",
        "decimals\\(\\)"
      ],
      "unambiguous": true,
      "risk_tags": [
        "decimal_mismatch",
        "assumed_decimals"
      ],
      "severity_ceiling_hint": "Medium",
      "review_hint": "Reads/uses token.decimals(). Confirm the value is actually fetched (not assumed) and applied consistently to BOTH operands of any comparison/division. Tokens with 6 vs 18 decimals must be normalized to a common unit before math.",
      "examples": [
        "uint8 d = IERC20Metadata(token).decimals();",
        "amount * 10**(18 - decimals)"
      ],
      "specificity": 1
    },
    "assumed_18_decimals": {
      "name_patterns": [],
      "call_patterns": [],
      "constant_patterns": [
        "1e18",
        "10\\*\\*18",
        "1_000_000_000_000_000_000",
        "wad"
      ],
      "arithmetic_patterns": [
        "mul\\(\\s*1e18\\s*\\)",
        "\\*\\s*1e18",
        "1e18\\s*\\)?\\.div",
        "\\.div\\([^)]*1e18"
      ],
      "risk_tags": [
        "assumed_decimals",
        "decimal_mismatch",
        "precision_loss"
      ],
      "severity_ceiling_hint": "High",
      "review_hint": "Hardcoded 1e18 scaling in amount/price/reserve math ASSUMES 18-decimal operands. If a reserve/token/oracle answer is 6 or 8 decimals, the result is mis-scaled by 10^(18-d). THE #184 SHAPE: reserve0.mul(1e18).div(reserve1) with a non-18-decimal token.",
      "examples": [
        "reserve0.mul(1e18).div(reserve1)",
        "amount * 1e18 / price"
      ],
      "specificity": 0
    },
    "chainlink_decimals": {
