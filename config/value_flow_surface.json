{
  "version": "value-flow-surface-v1",
  "description": "Phase-35 RESEARCH-ONLY library-aware value-flow surfacing lane. Read ONLY by scripts/value_flow_surface.py (un-wired). Adds candidate-queue lanes that represent library-resident value-flow transforms (incl. pure/view helpers feeding mutating callers) BEFORE diversity caps eliminate them, fixing the P33 recall miss where view library transforms were dropped by the value/state overlay's view/pure refusal + class-cap starvation. Vocab is GENERIC standard-DeFi only — NO subject-specific (e.g. dittoeth) file/contract/function names. is_gate:false research_only:true routes_in_production:false routed_manifest_ids:[].",
  "is_gate": false,
  "research_only": true,
  "routes_in_production": false,
  "routed_manifest_ids": [],

  "library_file_patterns": ["/libraries/", "/lib/", "/utils/"],
  "library_contract_patterns": ["^lib", "^math", "^oracle", "^bytes", "^util", "^pricing", "^accounting", "^vault", "^shares?", "^rewards?", "^debt", "^collateral", "^fixedpoint", "^safecast"],

  "value_flow_terms": ["amount", "value", "price", "rate", "debt", "collateral", "fee", "penalty", "reward", "yield", "share", "balance", "bid", "ask", "scale", "ratio", "percent", "precision", "decimals", "redeem", "redeemed", "liquidat", "interest", "principal", "discount"],

  "lane_signals": {
    "bytes_decode_transform": ["abi.decode", "abi.encode", "abi.encodepacked", "mload", "mstore", "calldataload", "assembly", "shr(", "shl(", ">>", "<<", "& 0x", ".slice", "offset", "packed", "bytes32(", "bytes("],
    "oracle_value_derivation": ["oracle", "price", "stale", "latestprice", "latestround", "roundid", "twap", "decimals", "circuitbreaker", "spotprice", "getsafe"],
    "accounting_utility": ["debt", "collateral", "share", "balance", "accrue", "yield", "fee", "ratio", "interest", "principal", "rewardrate", "ercdebt"]
  },

  "exclusion_terms": ["pause", "unpause", "whennotpaused", "onlyowner", "onlyadmin", "onlyrole", "grantrole", "revokerole", "renounceowner", "transferownership", "_authorizeupgrade", "setadmin", "setowner", "_disableinitializers"],

  "mutating_caller_signals": ["transfer", "safetransfer", "transferfrom", "mint", "burn", "deposit", "withdraw", "send", "settle", "liquidat", "redeem", "repay", "borrow", "claim", "swap", "exit", "create", "fill", "update", "set", "increase", "decrease", "_modify"],

  "budget": {
    "total": 14,
    "reserved_slots": {
      "library_value_flow": 4,
      "downstream_mutation_dependency": 3,
      "bytes_decode_transform": 2,
      "oracle_value_derivation": 2,
      "accounting_utility": 2
    },
    "cap_per_file": 3,
    "cap_per_operation_family": 4,
    "cap_per_caller_family": 4
  }
}
