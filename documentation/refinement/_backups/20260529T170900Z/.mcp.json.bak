{
  "mcpServers": {
    "onchain-context": {
      "command": "python",
      "args": ["tools/onchain_mcp_server.py"],
      "env": {
        "QUICKNODE_ENDPOINT_ETHEREUM": "${QUICKNODE_ENDPOINT_ETHEREUM}",
        "QUICKNODE_ENDPOINT_ARBITRUM": "${QUICKNODE_ENDPOINT_ARBITRUM}",
        "QUICKNODE_ENDPOINT_BASE": "${QUICKNODE_ENDPOINT_BASE}",
        "QUICKNODE_ENDPOINT_POLYGON": "${QUICKNODE_ENDPOINT_POLYGON}",
        "ETHERSCAN_API_KEY": "${ETHERSCAN_API_KEY}",
        "DUNE_API_KEY": "${DUNE_API_KEY}",
        "GRAPH_API_KEY": "${GRAPH_API_KEY}"
      }
    },
    "kb-search": {
      "command": "python",
      "args": ["tools/kb_mcp_server.py"]
    },
    "immunefi-audit-competitions": {
      "url": "https://reports.immunefi.com/~gitbook/mcp"
    }
  }
}
