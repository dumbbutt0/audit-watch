{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L3ReadinessRecord",
  "description": "Dry-run, research-only L3 realized-impact readiness record for a candidate attempting HIGH_CONFIRMED. Advisory overlay; never submits/routes/promotes. Aligns severity vocab with schemas/severity_calibration.schema.json.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "candidate_id",
    "threat_ceiling",
    "l3_status",
    "poc_tier",
    "poc_path",
    "poc_command",
    "poc_result",
    "actual_delta",
    "expected_delta_or_control",
    "affected_asset_or_state",
    "attacker_model",
    "victim_or_protocol_loss",
    "magnitude_basis",
    "source_validity_notes",
    "dependency_mocks",
    "production_source_modified",
    "research_only",
    "routes_in_production"
  ],
  "properties": {
    "candidate_id": { "type": "string" },
    "threat_ceiling": { "type": "string", "enum": ["CRITICAL_THREAD", "HIGH_THREAD", "MEDIUM_THREAD", "LOW_THREAD", "UNKNOWN"] },
    "awarded_severity": { "type": "string", "description": "optional ground-truth label for backtest only", "enum": ["critical", "high", "medium", "low", "qa", "invalid", "unknown"] },
    "l3_status": { "type": "string", "enum": ["PASS", "FAIL", "NEEDS_HARNESS", "NOT_ATTEMPTED", "HUMAN_OVERRIDE"] },
    "poc_tier": { "type": "string", "enum": ["L1_STATIC_TRACE", "L2_UNIT_HARNESS", "L3_REAL_CONTRACT_POC", "HUMAN_EQUIVALENT", "NONE"] },
    "poc_path": { "type": "string" },
    "poc_command": { "type": "string" },
    "poc_result": { "type": "string" },
    "actual_delta": { "type": "string" },
    "expected_delta_or_control": { "type": "string" },
    "affected_asset_or_state": { "type": "string" },
    "attacker_model": { "type": "string", "enum": ["permissionless", "program_accepted", "privileged_only", "trusted_admin", "unknown", "none"] },
    "victim_or_protocol_loss": { "type": "string" },
    "magnitude_basis": { "type": "string" },
    "source_validity_notes": { "type": "string" },
    "dependency_mocks": { "type": "string", "enum": ["none", "external_only", "creates_vulnerable_condition", "unknown"] },
    "impact_class": { "type": "string", "enum": ["theft", "permanent_loss", "insolvency", "privileged_control", "dos", "griefing", "precision", "auth_only", "bounded_local", "other", "unknown"] },
    "production_source_modified": { "type": "boolean" },
    "high_promotion_allowed": { "type": "boolean", "description": "derived by validate_p208_l3_readiness.decide()" },
    "high_promotion_blocker": { "type": "string" },
    "calibrated_severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "qa", "invalid", "needs_harness_for_severity"] },
    "bounded_griefing_dos": { "type": "boolean", "description": "P227 additive: author flag that this is a BOUNDED griefing/DoS (fee-loss / self-scoped / selective / no principal theft). When true and impact_class in {dos,griefing}, decide() caps the finding at Medium even if base conditions allow High (flag-independent; disjoint from the P214 core-path DoS carve-out). Set false to explicitly mark a NON-bounded core-path DoS." },
    "_p214_dos_carveout": { "type": "string", "description": "P214 additive: deterministic core-path DoS carve-out evidence (all optional; absent => no upgrade; only applied when AUDITWATCH_L3_READINESS=1). See CARVEOUT_POLICY.md." },
    "dos_carveout_candidate": { "type": "boolean" },
    "executed_l3_harness": { "type": "boolean" },
    "deterministic_failure": { "type": "boolean" },
    "core_protocol_path": { "type": "boolean" },
    "supported_asset_or_path": { "type": "boolean" },
    "no_practical_workaround": { "type": "boolean" },
    "permissionless_or_normal_user_trigger": { "type": "boolean" },
    "affects_user_class_or_protocol_function": { "type": "boolean" },
    "not_self_inflicted_only": { "type": "boolean" },
    "control_case_demonstrates_expected_success": { "type": "boolean" },
    "no_trusted_admin_prereq": { "type": "boolean" },
    "dos_carveout_notes": { "type": "string" },
    "dos_carveout_human_judgment_required": { "type": "boolean" },
    "research_only": { "const": true },
    "routes_in_production": { "const": false }
  }
}
