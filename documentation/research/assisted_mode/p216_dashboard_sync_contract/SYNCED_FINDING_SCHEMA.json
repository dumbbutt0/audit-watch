{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synced Finding (synced-1) — canonical dashboard routing contract",
  "description": "One synced-finding shape consumed by /findings, /candidates, /funnel. Superset of the funnel-1 record (so existing readers + finding_detail.build_verifier_evidence render it) plus the full H5-style verifier checklist and safety fields. research_only/review_only; never routes; never flips canonical submission_ready; browser never computes severity.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema", "record_id", "candidate_id", "source_track", "research_only", "review_only",
    "routes_in_production", "routing_allowed", "submission_ready", "conversion", "poc",
    "submission", "no_submit_controls", "browser_computes_severity", "human_review_required"
  ],
  "properties": {
    "schema": {"const": "synced-1"},
    "record_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "source_track": {"enum": ["audit_workspace", "funnel", "runtime", "detector", "campaign", "l3", "dry_run_queue"]},
    "workspace_or_audit": {"type": ["string", "null"]},
    "phase_discovered": {"type": ["string", "null"]},

    "research_only": {"const": true},
    "review_only": {"const": true},
    "routes_in_production": {"const": false},
    "routing_allowed": {"const": false},
    "submission_ready": {"const": false},
    "canonical_submission_ready_source": {"type": "string", "description": "where the REAL submission gate lives (machine-owned); the dashboard never sets it"},
    "human_review_required": {"const": true},
    "no_submit_controls": {"const": true},
    "browser_computes_severity": {"const": false},

    "l3_status": {"type": ["string", "null"]},
    "high_promotion_allowed": {"type": ["boolean", "null"]},
    "high_promotion_blocker": {"type": ["string", "null"]},

    "conversion": {"enum": ["CLEAN_HIT", "STRONG_PARTIAL", "ADJACENT", "REJECTED", "ABSTAINED", "NONE"]},
    "conversion_outcome": {"type": ["string", "null"]},
    "conversion_classification": {"type": ["string", "null"]},
    "severity_recommendation": {"type": ["string", "null"], "description": "ONLY a recorded severity or unknown/HUMAN_PENDING; never a conversion token; never inferred"},
    "novelty_status": {"type": ["string", "null"]},
    "novelty_duplicate": {"type": ["string", "null"]},
    "readiness_state": {"type": ["string", "null"]},
    "submission_package_status_derived": {"type": ["string", "null"]},
    "last_reviewer_note": {"type": ["string", "null"]},

    "title": {"type": ["string", "null"]},
    "summary": {"type": ["string", "null"]},
    "affected_contracts": {"type": "array", "items": {"type": "string"}},
    "affected_functions": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "object"},

    "mechanism": {"type": ["string", "null"]},
    "root_cause": {"type": ["string", "null"]},
    "attacker_model": {"type": ["string", "null"]},
    "exploit_steps": {"type": "array", "items": {"type": "string"}},
    "function_map": {"type": "array"},
    "defense_map": {"type": "array"},
    "poc_verification": {"type": "object"},
    "impact_and_severity": {"type": ["string", "object", "null"]},
    "intent_scope_operator_assumptions": {"type": ["string", "object", "null"]},
    "main_blocker": {"type": ["string", "null"]},
    "final_triager_decision": {"type": ["string", "null"]},
    "red_flags": {"type": "array"},
    "evidence_backup": {"type": "array"},
    "raw_fields": {"type": "object"},

    "_comment_funnel1": "Below: funnel-1 fields the existing readers/normalizer/card consume. Kept on the record so funnel.load_records() + build_verifier_evidence render with no special-casing.",
    "subject": {"type": ["string", "null"]},
    "finding_id": {"type": ["string", "null"]},
    "contract": {"type": ["string", "null"]},
    "function": {"type": ["string", "null"]},
    "contract_function": {"type": ["string", "null"]},
    "surface_function": {"type": ["string", "null"]},
    "target": {"type": ["string", "null"]},
    "suspected_mechanism": {"type": ["string", "null"]},
    "mechanism_correctness": {"type": ["string", "null"]},
    "severity_gate": {"type": ["string", "null"]},
    "claimed_severity": {"type": ["string", "null"]},
    "impact": {"type": ["string", "null"]},
    "vulnerable_output": {"type": ["string", "null"]},
    "reachability_verdict": {"type": ["string", "null"]},
    "limitations": {"type": ["string", "null"]},
    "blocker_reason": {"type": ["string", "null"]},
    "artifact_links": {"type": "object"},
    "p155_gate1_source_intent": {"type": ["string", "null"]},
    "p155_gate2_attacker_model": {"type": ["string", "null"]},
    "poc": {
      "type": "object",
      "required": ["poc_status"],
      "properties": {"poc_status": {"enum": ["NOT_STARTED", "IN_PROGRESS", "REPRODUCED", "PARTIAL_REPRO", "NOT_REPRODUCED"]}},
      "additionalProperties": true
    },
    "submission": {
      "type": "object",
      "properties": {
        "submission_status": {"enum": ["NOT_STARTED", "DRAFTING", "READY_FOR_HUMAN_REVIEW", "BLOCKED", "SUBMITTED"]},
        "duplicate_check_status": {"type": "string"},
        "scope_check_status": {"type": "string"},
        "severity_check_status": {"type": "string"},
        "final_human_gate": {"type": "string"}
      },
      "additionalProperties": true
    },
    "safety": {"type": "object"}
  }
}
