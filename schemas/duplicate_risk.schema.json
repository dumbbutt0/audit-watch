{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DuplicateRisk",
  "type": "object",
  "required": ["finding_id", "duplicate_risk", "internal_duplicates",
               "external_similar_findings", "overlap_reason", "unique_angle",
               "recommended_action", "compound_split_recommended", "confidence"],
  "properties": {
    "finding_id": { "type": "string" },
    "duplicate_risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "internal_duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "overlap_type", "shared_root_cause",
                     "shared_fix", "distinguishable"],
        "properties": {
          "finding_id":       { "type": "string" },
          "overlap_type":     { "type": "string" },
          "shared_root_cause": { "type": "boolean" },
          "shared_fix":        { "type": "boolean" },
          "distinguishable":   { "type": "boolean" }
        }
      }
    },
    "external_similar_findings": { "type": "array", "items": { "type": "string" } },
    "overlap_reason":   { "type": "string" },
    "unique_angle":     { "type": "string" },
    "recommended_action": {
      "type": "string",
      "enum": ["submit_separately", "merge", "mention_as_impact", "drop"]
    },
    "compound_split_recommended": { "type": "boolean" },
    "confidence": { "type": "integer", "minimum": 1, "maximum": 5 }
  }
}
