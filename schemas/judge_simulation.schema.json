{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JudgeSimulation",
  "type": "object",
  "required": ["finding_id", "predicted_outcome", "predicted_severity",
               "confidence", "strongest_objection", "likely_judge_questions",
               "severity_downgrade_reasons", "duplicate_risk_reasons",
               "missing_evidence", "rewrite_suggestions", "persona_verdicts",
               "final_submit_recommendation"],
  "properties": {
    "finding_id": { "type": "string" },
    "predicted_outcome": {
      "type": "string",
      "enum": ["accepted", "accepted_downgraded", "duplicate_risk", "rejected", "needs_poc"]
    },
    "predicted_severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "qa", "invalid"]
    },
    "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
    "strongest_objection":        { "type": "string" },
    "likely_judge_questions":     { "type": "array", "items": { "type": "string" } },
    "severity_downgrade_reasons": { "type": "array", "items": { "type": "string" } },
    "duplicate_risk_reasons":     { "type": "array", "items": { "type": "string" } },
    "missing_evidence":           { "type": "array", "items": { "type": "string" } },
    "rewrite_suggestions":        { "type": "array", "items": { "type": "string" } },
    "persona_verdicts": {
      "type": "object",
      "required": ["strict_judge", "protocol_sponsor", "duplicate_hunter",
                   "downgrade_judge", "exploit_skeptic"],
      "properties": {
        "strict_judge":      { "type": "string" },
        "protocol_sponsor":  { "type": "string" },
        "duplicate_hunter":  { "type": "string" },
        "downgrade_judge":   { "type": "string" },
        "exploit_skeptic":   { "type": "string" }
      }
    },
    "final_submit_recommendation": {
      "type": "string",
      "enum": ["submit", "revise", "poc_first", "drop"]
    }
  }
}
