{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PoCPlan",
  "description": "Detailed plan for generating a proof-of-concept test",
  "type": "object",
  "required": [
    "finding_id", "test_name", "goal", "minimal_setup", "attack_steps",
    "assertions", "files_to_create", "files_to_modify", "run_command",
    "expected_output", "failure_modes"
  ],
  "properties": {
    "finding_id":       { "type": "string" },
    "test_name":        { "type": "string", "pattern": "^poc_[a-z0-9_]+$" },
    "goal":             { "type": "string" },
    "poc_approach":     {
      "type": "string",
      "enum": ["pure_arithmetic", "unit_integration", "mock_contract", "state_machine"]
    },
    "minimal_setup":    { "type": "array", "items": { "type": "string" } },
    "attack_steps":     { "type": "array", "items": { "type": "string" } },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expression": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "key_constants": {
      "type": "object",
      "description": "Named constants needed in the test (e.g. WAD, USDC_DECIMALS)",
      "additionalProperties": { "type": "string" }
    },
    "functions_to_reproduce": {
      "type": "array",
      "description": "For pure_arithmetic approach: which source functions to inline",
      "items": { "type": "string" }
    },
    "files_to_create":  { "type": "array", "items": { "type": "string" } },
    "files_to_modify":  { "type": "array", "items": { "type": "string" } },
    "run_command":      { "type": "string" },
    "expected_output":  { "type": "string" },
    "failure_modes":    { "type": "array", "items": { "type": "string" } },
    "notes":            { "type": "string" }
  }
}
