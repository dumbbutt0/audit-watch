{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PoCQueueEntry",
  "description": "A single entry in the PoC work queue, derived from a triaged finding",
  "type": "object",
  "required": [
    "finding_id", "priority", "title", "target_contract", "target_function",
    "language", "framework", "bug_type", "claim_to_prove", "expected_result", "confidence"
  ],
  "properties": {
    "finding_id":       { "type": "string" },
    "priority":         { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "title":            { "type": "string" },
    "target_contract":  { "type": "string" },
    "target_function":  { "type": "string" },
    "language":         { "type": "string", "enum": ["rust", "solidity", "typescript", "python", "other"] },
    "framework":        { "type": "string", "enum": ["soroban", "foundry", "anchor", "hardhat", "cosmwasm", "other"] },
    "bug_type": {
      "type": "string",
      "enum": [
        "arithmetic_unit_mismatch", "arithmetic_overflow", "arithmetic_rounding",
        "access_control_missing_auth", "access_control_role_confusion",
        "reentrancy_cross_function", "reentrancy_read_only",
        "oracle_stale_price", "oracle_manipulation", "oracle_config_bug",
        "dos_unbounded_loop", "dos_fund_lock",
        "accounting_toctou", "accounting_wrong_formula",
        "logic_error", "other"
      ]
    },
    "claim_to_prove":   { "type": "string" },
    "expected_result":  { "type": "string" },
    "required_setup":   { "type": "array", "items": { "type": "string" } },
    "source_locations": { "type": "array", "items": { "type": "string" } },
    "confidence":       { "type": "integer", "minimum": 1, "maximum": 5 },
    "poc_approach": {
      "type": "string",
      "enum": ["pure_arithmetic", "unit_integration", "mock_contract", "state_machine"]
    },
    "notes":            { "type": "string" }
  }
}
