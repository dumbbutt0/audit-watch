{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PoCResult",
  "description": "Result of running a proof-of-concept test",
  "type": "object",
  "required": [
    "finding_id", "status", "test_file", "run_command",
    "assertion_hit", "evidence_summary"
  ],
  "properties": {
    "finding_id":       { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["proved", "failed", "inconclusive", "needs_manual_work", "compile_error"]
    },
    "test_file":        { "type": "string" },
    "run_command":      { "type": "string" },
    "stdout_excerpt":   { "type": "string" },
    "stderr_excerpt":   { "type": "string" },
    "assertion_hit":    { "type": "boolean" },
    "repair_attempts":  { "type": "integer", "minimum": 0 },
    "evidence_summary": { "type": "string" },
    "next_steps":       { "type": "array", "items": { "type": "string" } },
    "generated_at":     { "type": "string", "format": "date-time" }
  }
}
