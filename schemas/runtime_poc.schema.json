{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimePoC",
  "type": "object",
  "required": ["finding_id", "runtime_level", "status", "real_function_called",
               "public_entrypoint_called", "copied_logic_used", "test_file_path",
               "test_file_content", "run_command", "assertion",
               "stdout_excerpt", "stderr_excerpt", "limitations",
               "next_upgrade", "repair_attempts"],
  "properties": {
    "finding_id":              { "type": "string" },
    "runtime_level":           { "type": "integer", "minimum": 0, "maximum": 4 },
    "status": {
      "type": "string",
      "enum": ["proved", "failed", "inconclusive", "harness_only", "skipped", "blocked", "error"]
    },
    "real_function_called":      { "type": "boolean" },
    "public_entrypoint_called":  { "type": "boolean" },
    "copied_logic_used":         { "type": "boolean" },
    "test_file_path":            { "type": "string" },
    "test_file_content":         { "type": "string" },
    "run_command":               { "type": "string" },
    "assertion":                 { "type": "string" },
    "stdout_excerpt":            { "type": "string" },
    "stderr_excerpt":            { "type": "string" },
    "limitations":               { "type": "array", "items": { "type": "string" } },
    "next_upgrade":              { "type": "string" },
    "repair_attempts":           { "type": "integer", "minimum": 0 }
  }
}
