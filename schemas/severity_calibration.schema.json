{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeverityCalibration",
  "type": "object",
  "required": ["finding_id", "original_severity", "triage_severity",
               "calibrated_severity", "confidence", "severity_drivers",
               "downgrade_triggers", "upgrade_triggers", "rules_applied",
               "similar_historical_cases", "recommended_report_wording",
               "calibration_source"],
  "properties": {
    "finding_id":        { "type": "string" },
    "original_severity": { "type": "string" },
    "triage_severity":   { "type": "string" },
    "calibrated_severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "qa", "invalid"]
    },
    "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
    "severity_drivers":          { "type": "array", "items": { "type": "string" } },
    "downgrade_triggers":        { "type": "array", "items": { "type": "string" } },
    "upgrade_triggers":          { "type": "array", "items": { "type": "string" } },
    "rules_applied":             { "type": "array", "items": { "type": "string" } },
    "similar_historical_cases":  { "type": "array", "items": { "type": "string" } },
    "recommended_report_wording": { "type": "string" },
    "calibration_source": {
      "type": "string",
      "enum": ["rules_only", "historical", "judge_informed", "poc_informed"]
    }
  }
}
