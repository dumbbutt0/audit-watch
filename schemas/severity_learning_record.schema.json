{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeverityLearningRecord",
  "type": "object",
  "required": ["finding_id", "claimed_severity", "final_judged_severity",
               "contest", "reason_for_change", "bug_family",
               "attacker_model", "impact_type", "lesson", "date"],
  "properties": {
    "finding_id":           { "type": "string" },
    "claimed_severity":     { "type": "string" },
    "final_judged_severity": { "type": "string" },
    "contest":              { "type": "string" },
    "reason_for_change":    { "type": "string" },
    "bug_family":           { "type": "string" },
    "attacker_model":       { "type": "string" },
    "impact_type":          { "type": "string" },
    "lesson":               { "type": "string" },
    "date":                 { "type": "string" }
  }
}
